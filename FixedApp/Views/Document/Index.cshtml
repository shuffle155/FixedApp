@model IEnumerable<FixedApp.Models.Document>
@{
	ViewData["Title"] = "Manage documents";
}
<table class="table table-bordered mt-3">
	<thead>
		<tr>
			<th>ID</th>
			<th>Title</th>
			<th>Operations</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var document in Model)
		{
			<tr>
				<td>@document.Id</td>
				<td>@document.Title</td>
				<td>
					<a asp-action="Details" asp-route-id="@document.Id" class="btn btn-info btn-sm">View</a>
					<a asp-action="Edit" asp-route-id="@document.Id" class="btn btn-warning btn-sm">Edit</a>
					<a asp-action="Delete" asp-route-id="@document.Id" class="btn btn-danger btn-sm">Delete</a>
				</td>
			</tr>
		}
	</tbody>
</table>