@model FixedApp.Models.Document
@{
	ViewData["Title"] = "Edit document";
}
<form method="post" asp-action="Edit" class="mt-3">
	<input type="hidden" name="hashId" value="@ViewBag.HashId" />
	<input type="text" name="title" value="@Model.Title" disabled />
	<div class="mb-3">
		<label for="content" class="form-label">New content:</label>
		<textarea class="form-control" id="content" name="content">@Model.Content</textarea>
	</div>
	<button type="submit" class="btn btn-primary">Save</button>
	<a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>