@model FixedApp.Models.Document
@{
	ViewData["Title"] = "Document details";
}
<div class="card mt-3">
	<div class="card-body">
		<h5 class="card-title">Title: @Model.Title</h5>
		<h6 class="card-subtitle mb-2">Owner ID: @Model.OwnerId</h6>
		<h6 class="card-subtitle">Content:</h6>
		<p class="card-text">@Model.Content</p>
	</div>
</div>
<a asp-action="Index" class="btn btn-secondary mt-3">Back</a>